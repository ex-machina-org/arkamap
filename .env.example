# Backend settings. Local uvicorn reads .env.local via --env-file (scripts/init-local.ps1 creates it from this file);
# docker compose reads .env and overrides the database and broker addresses itself. Never commit either file.
DATABASE_URL=postgresql://arkamap@127.0.0.1:55432/arkamap
CORS_ORIGINS=http://localhost:5174
# 1 = every /api/* call needs X-API-Key. Issue keys with: python -m app.clients create "name"
REQUIRE_API_KEY=0
API_KEYS=
ENABLE_SCHEDULER=0
# Registering a device provisions MQTT credentials, so the broker must be reachable.
MQTT_HOST=localhost
MQTT_BRIDGE_PASSWORD=dev-bridge-password
# Optional: NASA FIRMS area endpoint for more detailed hotspots; the keyless regional feed works without it.
FIRMS_MAP_KEY=
# Optional LLM providers for Jev; without them Jev answers from templates.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Last LLM fallback (prefix completion)
DEEPSEEK_API_KEY=
# Optional: TypeSafe Jev SDK (ingest/jev.py), parked
TYPESAFE_API_KEY=
