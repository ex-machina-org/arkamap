# Frontend VPS: the only address browsers and IoT devices ever use. It serves the
# built app and forwards every /api/* call (HTTP ingest, MQTT WebSocket, chat stream)
# to the backend server-to-server, so the backend's address is never published.
#
#   npm run build  ->  copy dist/ to /srv/arkamap
#   .env: ARKAMAP_API_KEY=<app key>   BACKEND_ORIGIN=https://<backend host>
#
# Caddy obtains the TLS certificate itself once DNS points at this VPS.

arkamap.winatra.app {
	encode zstd gzip

	# Browser calls carry no key: add the app key. Devices send their own key to
	# /api/ingest and /api/mqtt, which must reach the backend untouched.
	@no_key {
		path /api/*
		not header X-API-Key *
	}
	request_header @no_key X-API-Key {$ARKAMAP_API_KEY}

	handle /api/* {
		# WebSocket upgrades (/api/mqtt) pass through reverse_proxy as is.
		reverse_proxy {$BACKEND_ORIGIN} {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
			# The backend gives devices this domain (not its own) in the quickstart.
			header_up X-Arkamap-Origin https://arkamap.winatra.app
			# The chat answer streams (SSE): send each chunk as it arrives.
			flush_interval -1
		}
	}

	handle {
		root * /srv/arkamap
		try_files {path} /index.html
		file_server
	}
}
