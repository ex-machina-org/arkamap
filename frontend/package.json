{
  "name": "arkamap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:hosted": "vite --mode hosted --host 127.0.0.1 --port 5174 --strictPort",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/init-local.ps1",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "architecture:check": "node scripts/check-architecture.mjs",
    "catalog:check": "node scripts/check-catalog.mjs",
    "check": "npm run lint && npm run typecheck && npm run architecture:check && npm run catalog:check",
    "api:generate": "node scripts/python.mjs scripts/export-openapi.py && node scripts/generate-api-types.mjs",
    "api:check": "node scripts/python.mjs scripts/export-openapi.py --check && node scripts/generate-api-types.mjs --check",
    "test:api": "node --test scripts/api-contract.test.mjs",
    "backend:dev": "node scripts/python.mjs -m uvicorn app.main:app --app-dir backend --env-file .env.local --host 127.0.0.1 --port 8000 --no-proxy-headers",
    "backend:test": "node scripts/python.mjs backend/test_iot.py && node scripts/python.mjs backend/test_agent.py && node scripts/python.mjs backend/test_bmkg.py"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.119",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@types/three": "^0.186.0",
    "ai": "^7.0.116",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "maplibre-gl": "^6.11.1",
    "motion": "^13.4.2",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.8",
    "react-grid-layout": "2.2.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "tw-animate-css": "^1.4.0",
    "voice-glow": "^0.3.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "agentation": "^3.1.2",
    "oxlint": "^1.81.0",
    "polygon-clipping": "^0.15.7",
    "react-grab": "^0.2.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
