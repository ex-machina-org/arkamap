# Terpisah dari API: Chainlit membawa versi fastapi/starlette sendiri yang
# bentrok dengan pin di requirements.txt. Layanan ini hanya butuh httpx.
FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir chainlit==2.12.0 httpx==0.28.1 requests
COPY chainlit_app.py .
CMD ["chainlit", "run", "chainlit_app.py", "--host", "0.0.0.0", "--port", "8001", "--headless"]
